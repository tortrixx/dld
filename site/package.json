{
  "name": "dld-puzzle-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "tortrixx/dld —— MAX II 8x8 双色点阵拼图游戏的工程展示站（静态站点，可部署到 GitHub Pages）",
  "scripts": {
    "predev": "node scripts/sync-figures.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-figures.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:facts": "node scripts/verify-facts.mjs",
    "check": "tsc --noEmit && vitest run && node scripts/verify-facts.mjs && npm run build",
    "shots": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
