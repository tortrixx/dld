# ============================================================
#  puzzle.qsf -- Quartus II 9.1 project settings
#  GENERATED BY scripts/gen_project.py -- do not hand-edit pins.
#  Pin numbers come from the board manual; they are NOT guesses.
# ============================================================

set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM1270T144C5
set_global_assignment -name TOP_LEVEL_ENTITY puzzle_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 9.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ---------------- source files ----------------
set_global_assignment -name VHDL_FILE ../rtl/puzzle_pkg.vhd
set_global_assignment -name VHDL_FILE ../rtl/clk_gen.vhd
set_global_assignment -name VHDL_FILE ../rtl/keypad_scan.vhd
set_global_assignment -name VHDL_FILE ../rtl/seg_scan.vhd
set_global_assignment -name VHDL_FILE ../rtl/dot_matrix_scan.vhd
set_global_assignment -name VHDL_FILE ../rtl/pattern_rom.vhd
set_global_assignment -name VHDL_FILE ../rtl/piece_rom.vhd
set_global_assignment -name VHDL_FILE ../rtl/rng_lfsr.vhd
set_global_assignment -name VHDL_FILE ../rtl/puzzle_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/disp_format.vhd
set_global_assignment -name VHDL_FILE ../rtl/game_fsm.vhd
set_global_assignment -name VHDL_FILE ../rtl/buzzer_ctrl.vhd
set_global_assignment -name VHDL_FILE ../rtl/puzzle_top.vhd
set_global_assignment -name VHDL_FILE ../rtl/board_test_top.vhd
set_global_assignment -name VHDL_FILE ../rtl/keypad_diag_top.vhd
set_global_assignment -name VHDL_FILE ../rtl/keypad_raw_top.vhd

# ---------------- timing ----------------
set_global_assignment -name SDC_FILE puzzle.sdc

# ---------------- device options ----------------
set_global_assignment -name DEVICE_FILTER_PACKAGE TQFP
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144
# unused pins: keep them high-Z so the LCD / PS2 / VGA pins do not fight
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name AUTO_RESOURCE_SHARING ON
set_global_assignment -name SEED 6

# ---------------- pins ----------------
set_location_assignment PIN_18 -to clk
set_location_assignment PIN_125 -to sw7
