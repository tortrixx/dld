<mxfile host="dsh" type="device">
  <diagram id="d1" name="fig_game_flow">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2121" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="loop" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.2;fontSize=19;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="400.0" y="819.0" width="1220.0" height="702.0" as="geometry"/></mxCell>
        <mxCell id="loop_title" value="对局循环  S_PLAYING（限时 30 / 40 / 60 s）" style="text=;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Microsoft YaHei;fontColor=#b45309;fontStyle=1;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="416.0" y="827.0" width="560" height="20" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;上电 / 复位&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="700.0" y="51.0" width="340.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="sw" value="&lt;b&gt;SW7 = 1 ？&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;（系统使能开关）&lt;/span&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="660.0" y="129.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="quiet" value="&lt;b&gt;全系统静默熄灭&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;（低功耗，所有显示器件不显示）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;SW7 重新置 1 后回到上方判定&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="152.0" width="500.0" height="88.0" as="geometry"/></mxCell>
        <mxCell id="self" value="&lt;b&gt;自检 S_SELF_TEST（约 2 s）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;点阵 64 点全亮黄闪 2 Hz · 数码管 88888888 · POST 短鸣&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="290.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="idle" value="&lt;b&gt;待机 S_IDLE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;DISP7 显示 5 · DISP0 显示当前关卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="386.0" width="620.0" height="59.0" as="geometry"/></mxCell>
        <mxCell id="gokey" value="&lt;b&gt;按【开始】？&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="660.0" y="478.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="preview" value="&lt;b&gt;预览 S_PREVIEW（约 5 s）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;点阵红光显示目标图案 · DISP7 倒计时 5→1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="628.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="shuffle" value="&lt;b&gt;散落（LFSR 取锚点）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;与已落位零片重叠则重新采样，最多 15 次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="725.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="lk" value="&lt;b&gt;有按键？&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="620.0" y="879.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="ltime" value="&lt;b&gt;剩余 ≤ 1 s ？&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120.0" y="879.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="ldec" value="&lt;b&gt;译码并执行按键&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;选择 / 上 / 下 / 左 / 右 / 旋转 / 确认&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="1029.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="lhit" value="&lt;b&gt;碰撞或越界？&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="620.0" y="1126.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="lblock" value="&lt;b&gt;拦截：零片不动&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;（硬件实时拒绝非法指令）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1120.0" y="1146.0" width="420.0" height="59.0" as="geometry"/></mxCell>
        <mxCell id="lupd" value="&lt;b&gt;更新零片位置 / 朝向&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;按【确认】则锁定并并入已锁定平面&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="480.0" y="1276.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="lwin" value="&lt;b&gt;全图并集 == 目标图案&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;且全部零片已锁定？&lt;/span&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="604.0" y="1372.0" width="452.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="win" value="&lt;b&gt;过关 S_WIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;显示 PASS · 奏通关号角 · 结算先闪 2 周期后常亮&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="520.0" y="1583.0" width="620.0" height="63.0" as="geometry"/></mxCell>
        <mxCell id="lvlq" value="&lt;b&gt;关卡 &lt; 3 ？&lt;/b&gt;" style="shape=rhombus;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=2;fontSize=17;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="660.0" y="1680.0" width="420.0" height="117.0" as="geometry"/></mxCell>
        <mxCell id="nextlvl" value="&lt;b&gt;关卡 +1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16.5px&quot;&gt;→ 进入下一关预览&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;fontSize=19.5;fontFamily=Microsoft YaHei;fontColor=#0F172A;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1260.0" y="1700.0" width="460.0" height="59.0" as="geometry"/></mxCell>
