<mxfile host="Electron" modified="2026-10-21T00:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="core" name="拼图核心引擎微架构框图">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b1" value="&lt;b&gt;1. 随机散落与锚点生成&lt;/b&gt;&lt;br&gt;16位本原多项式 LFSR&lt;br&gt;动态采样生成 (dx, dy)&lt;br&gt;即时互检杜绝重叠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#15803D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;2. 64位几何变换处理器&lt;/b&gt;&lt;br&gt;零片 ROM 原型掩码输入&lt;br&gt;纯组合移位器二维平移&lt;br&gt;S3 触发 90° 顺时针旋转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1D4ED8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="190" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;3. 刚性碰撞拦截检测&lt;/b&gt;&lt;br&gt;越界检测: x&amp;lt;0 | x+w&amp;gt;8&lt;br&gt;重叠检测: piece AND locked&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;冲突单拍锁死禁止更新&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#B91C1C;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="60" width="180" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;4. 锁定与全图验证&lt;/b&gt;&lt;br&gt;S8 确认: piece 并入锁定面&lt;br&gt;全图比对: locked == target&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&lt;b&gt;100% 吻合即置高 match&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#6B21A8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b_buf" value="&lt;b&gt;双平面 64位 像素合成与 125 Hz 超临界行扫描消隐&lt;/b&gt;&lt;br&gt;&lt;br&gt;红光平面 (Red): 游离未选零片 + 锁定零片红分量&lt;br&gt;绿光平面 (Green): 当前选中零片 + ≤10s 幽灵闪烁辅助&lt;br&gt;黄光合成 (Yellow): 已正确锁定零片 (红+绿双亮)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="220" width="620" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="(x_pos, y_pos)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;strokeColor=#1E293B;fontSize=10;" edge="1" parent="1" source="b1" target="b2"/>
        <mxCell id="c2" value="piece_new" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;strokeColor=#1E293B;fontSize=10;" edge="1" parent="1" source="b2" target="b3"/>
        <mxCell id="c3" value="合法更新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;strokeColor=#1E293B;fontSize=10;" edge="1" parent="1" source="b3" target="b4"/>
